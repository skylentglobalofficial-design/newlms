{
  "appId": "live.skylent.app",
  "appName": "Skylent",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "skylent.live",
      "*.skylent.live",
      "accounts.google.com",
      "*.google.com"
    ]
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#0F172A",
      "style": "DARK"
    }
  }
}
