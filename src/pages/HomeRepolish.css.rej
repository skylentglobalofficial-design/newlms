diff a/src/pages/HomeRepolish.css b/src/pages/HomeRepolish.css	(rejected hunks)
@@ -1106,3 +1106,79 @@
   border-color: rgba(255, 255, 255, 0.35) !important;
   color: #ffffff !important;
 }
+
+
+/* ── Visual Presentation Polish: Unobstructed Hero Stage, Horizontal Workspace Pills & 4-Col Card Layout ── */
+.hx-page--home .hxw-stage {
+  display: grid;
+  gap: 14px;
+  padding: 16px;
+  border-radius: 24px;
+  background: linear-gradient(160deg, #EAE6FF 0%, #F5F3FF 100%);
+  border: 1px solid #DDD7FF;
+  box-shadow: 0 24px 48px -28px rgba(81, 66, 181, 0.22);
+}
+.hx-page--home .hxw-hero__photo {
+  aspect-ratio: 16 / 10;
+  border-radius: 16px;
+}
+.hx-page--home .hxw-ws {
+  position: relative !important;
+  left: auto !important;
+  bottom: auto !important;
+  width: 100% !important;
+  box-sizing: border-box;
+  padding: 16px 18px;
+  border-radius: 16px;
+  background: #ffffff;
+  border: 1px solid #DDD7FF;
+  box-shadow: 0 12px 28px -18px rgba(32, 37, 68, 0.25);
+}
+
+/* Fix raw browser bullets on ul.hx-canvas__note under InsideProgramme ("How learning works") */
+.hx-page--home ul.hx-canvas__note {
+  list-style: none;
+  padding: 0;
+  margin: 12px 0 0;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+.hx-page--home ul.hx-canvas__note li {
+  margin: 0;
+}
+.hx-page--home ul.hx-canvas__note a {
+  display: inline-flex;
+  align-items: center;
+  padding: 6px 14px;
+  border-radius: 999px;
+  background: #F5F3FF;
+  border: 1px solid #DDD7FF;
+  color: #43349F;
+  font-size: 13px;
+  font-weight: 650;
+  text-decoration: none;
+  transition: background-color 150ms ease, border-color 150ms ease;
+}
+.hx-page--home ul.hx-canvas__note a:hover {
+  background: #EAE6FF;
+  border-color: #5142B5;
+}
+
+/* Fix cramped 4-column text in HomeElixirFlywheel cards */
+.hxw-goal--card {
+  flex-direction: column !important;
+  align-items: flex-start !important;
+  gap: 12px !important;
+  height: 100%;
+  box-sizing: border-box;
+}
+.hxw-goal--card .hxw-goal__icon svg {
+  width: 20px !important;
+  height: 20px !important;
+}
+.hxw-goal--card .hxw-goal__name {
+  font-size: 16.5px;
+  line-height: 1.3;
+  margin-bottom: 4px;
+}
