{
  "name": "skylent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build && npm run backend:build",
    "start": "node server.js",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "backend:typecheck": "tsc -p tsconfig.backend.json --noEmit",
    "backend:build": "tsc -p tsconfig.backend.json",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:career": "tsx prisma/seed-career.ts",
    "db:preflight": "tsx scripts/check-migration-history.ts",
    "db:preflight:backfill": "tsx scripts/preflight-program-course-backfill.ts",
    "smoke:public": "tsx scripts/smoke-public.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:consent": "tsx scripts/test-consent.ts",
    "test:certificate-verify": "tsx scripts/test-certificate-verify.ts",
    "test:google-oauth": "tsx scripts/test-google-oauth.ts",
    "test:oauth-redirect": "tsx scripts/test-oauth-redirect.ts",
    "test:lms": "tsx scripts/test-lms.ts",
    "test:assignment-flow": "tsx scripts/test-assignment-flow.ts",
    "test:ai": "tsx scripts/test-skylent-ai.ts",
    "test:elixir": "tsx scripts/test-elixir.ts",
    "test:ai-policy": "tsx scripts/test-ai-policy.ts",
    "test:quiz-guard": "tsx scripts/test-quiz-guard.ts",
    "test:ai:live": "tsx scripts/test-skylent-ai-live.ts",
    "test:labs": "tsx scripts/test-skylent-labs.ts",
    "test:labs-sql": "tsx scripts/test-skylent-labs-sql.ts",
    "test:labs-visual": "tsx scripts/test-skylent-labs-visual.ts",
    "test:projects": "tsx scripts/test-skylent-projects.ts",
    "test:career-evidence": "tsx scripts/test-career-evidence.ts",
    "test:da-content": "tsx scripts/test-da-content.ts",
    "test:pm-content": "tsx scripts/test-pm-content.ts",
    "test:programme-positioning": "tsx scripts/test-programme-positioning.ts",
    "test:second-flagship": "tsx scripts/test-second-flagship.ts",
    "test:career": "tsx scripts/test-career.ts",
    "test:career-rise": "tsx scripts/test-career-rise.ts",
    "test:career-os-lock": "tsx scripts/test-career-os-lock.ts",
    "test:curriculum-authoring": "tsx scripts/test-curriculum-authoring.ts",
    "test:my-courses": "tsx scripts/test-my-courses.ts",
    "test:resume-upload-quiz": "tsx scripts/test-resume-upload-quiz.ts",
    "test:college-isolation": "tsx scripts/test-college-isolation.ts",
    "test:employer": "tsx scripts/test-employer-jobs.ts",
    "test:lesson-media": "tsx scripts/test-lesson-media.ts",
    "test:catalog-parity": "tsx scripts/test-catalog-truth.ts && tsx scripts/test-public-catalogue-copy.ts && tsx scripts/check-catalog-parity.ts",
    "test:live-intents": "tsx scripts/test-live-intents.ts",
    "test:roles": "tsx scripts/test-role-provisioning.ts",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:security-middleware": "tsx scripts/test-security-middleware.ts",
    "test:production-env": "tsx scripts/test-production-env.ts",
    "test:migration-history": "tsx scripts/test-migration-history.ts",
    "test:migration-replay": "tsx scripts/test-production-migration-replay.ts",
    "test:enrollment-access": "tsx scripts/test-enrollment-access.ts",
    "test:events": "tsx scripts/test-events.ts",
    "test:quiz-limits": "tsx scripts/test-quiz-limits.ts",
    "test:password-reset": "tsx scripts/test-password-reset-security.ts",
    "test:password-reset-http": "tsx scripts/test-password-reset-http.ts",
    "test:degrees-auth": "tsx scripts/test-degrees-authorization.ts",
    "test:storage": "tsx scripts/test-storage-validation.ts",
    "test:data-isolation": "tsx scripts/test-data-isolation.ts",
    "bootstrap:superadmin": "tsx scripts/bootstrap-superadmin.ts",
    "provision:demo": "tsx scripts/provision-demo-accounts.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "bcrypt": "^6.0.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "node-sql-parser": "^5.4.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.13",
    "vite": "^8.0.0",
    "zod": "^4.5.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11"
  },
  "devDependencies": {
    "oxfmt": "^0.2.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "ip-address": "10.7.3",
    "proxy-addr": "2.0.8",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  }
}
