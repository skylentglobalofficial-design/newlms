+    )
+    return {
+      awarded: !written.duplicate,
+      duplicate: written.duplicate,
+      amount,
+      balance: written.balance,
+    }
+  } catch (error) {
+    if (isUniqueConflict(error)) return { awarded: false as const, duplicate: true, amount: 0 }
+    return { awarded: false as const, amount: 0 }
