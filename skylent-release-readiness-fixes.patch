+  margin-top: 16px;
+  padding: 16px;
+  background: #090d16;
+  border: 1px solid #1e293b;
+  border-radius: 10px;
+}
+.hx-tryout__ok {
+  font-size: 12.5px;
+  font-weight: 600;
+  color: #4ade80;
+  margin-bottom: 10px;
+}
+.hx-tryout__table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: 12.5px;
+  text-align: left;
+}
+.hx-tryout__table th {
+  padding: 8px 10px;
+  border-bottom: 1px solid #334155;
+  color: #94a3b8;
+  font-family: var(--sk-font-mono);
+  font-weight: 500;
+}
+.hx-tryout__table td {
+  padding: 8px 10px;
+  border-bottom: 1px solid #1e293b;
+  color: #f8fafc;
+}
+.hx-tryout__table tr.is-leak {
+  background: rgba(239, 68, 68, 0.12);
+}
+.hx-tryout__table tr.is-leak td {
+  color: #fca5a5;
+  font-weight: 600;
+}
+.hx-tryout__foot {
+  margin-top: 14px;
+  padding-top: 12px;
+  border-top: 1px solid rgba(148, 163, 184, 0.18);
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px;
+  font-size: 13px;
+}
+.hx-tryout__coldcall {
+  background: hsl(var(--site-white));
+  border: 1px solid hsl(var(--site-border));
+  border-radius: 16px;
+  padding: clamp(20px, 3vw, 28px);
+  box-shadow: 0 20px 42px -32px rgba(16, 38, 61, 0.18);
+}
+.hx-tryout__prompt {
+  font-size: clamp(15px, 1.4vw, 17px);
+  font-weight: 550;
+  line-height: 1.5;
+  color: hsl(var(--site-ink));
+  margin: 10px 0 18px;
+}
+.hx-tryout__options {
+  display: grid;
+  gap: 10px;
+}
+.hx-tryout__opt {
+  padding: 13px 16px;
+  border-radius: 10px;
+  border: 1px solid hsl(var(--site-border));
+  background: hsl(var(--site-white));
+  text-align: left;
+  cursor: pointer;
+  transition: border-color 140ms ease, background 140ms ease;
+}
+.hx-tryout__opt:hover {
+  border-color: hsl(var(--site-deep));
+}
+.hx-tryout__opt.is-selected {
+  border: 2px solid hsl(var(--site-deep));
+  background: hsl(var(--site-soft-blue));
+}
+.hx-tryout__peer {
+  margin-top: 6px;
+  font-size: 12.5px;
+  color: hsl(var(--site-muted));
+}
+.hx-tryout__peer.is-optimal {
+  color: #15803d;
+}
+.hx-elixir-pills {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 18px;
+}
+.hx-elixir-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 5px 12px;
+  border-radius: 999px;
+  background: hsl(var(--site-soft-blue));
+  border: 1px solid hsl(var(--site-light-blue));
+  font-size: 12.5px;
+  font-weight: 600;
+  color: hsl(var(--site-deep));
+}
+@media (max-width: 800px) {
+  .hx-tryout__head {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
