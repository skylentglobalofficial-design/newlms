<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass through API routes and existing files/directories
  RewriteRule ^api/ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all SPA client routes (/courses, /events, /programmes/*, /verify/*, etc.) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
