# Database (both are required for Prisma CLI, migrations, and production/CI)
# DATABASE_URL — pooled/runtime connection string used by the application.
# DIRECT_URL — direct/non-pooled connection string used by Prisma migrate and validate.
# In many hosted Postgres setups these are the same URL; in serverless/pooled setups
# DIRECT_URL must bypass the pooler (e.g. Supabase "direct" connection).
# Never commit real credentials.
DATABASE_URL=
DIRECT_URL=

# Session / cookies
SESSION_SECRET=
COOKIE_SECURE=false

# Frontend origin used for OAuth redirects and (when CORS_ALLOWED_ORIGINS is unset) CORS.
# Local API+Vite: http://127.0.0.1:8443
# Production: the public HTTPS origin of this app (no trailing slash). Required when NODE_ENV=production.
FRONTEND_URL=http://127.0.0.1:8443

# Comma-separated browser origins allowed for credentialed API requests.
# When unset, FRONTEND_URL is used. In development, common localhost ports are also allowed.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443

# Optional API hardening overrides
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# JSON_BODY_LIMIT=512kb
# TRUST_PROXY=1
# COOKIE_SECURE=true

# Google OAuth (register redirect URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8443/api/v1/auth/google/callback

# First superadmin bootstrap (used by `npm run bootstrap:superadmin`).
# Never commit real values. SUPERADMIN_PASSWORD is only required when the
# account does not exist yet and must be at least 12 characters.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=

# Frontend feature flags
# Production / committed builds MUST use false (see .env.production).
# Local development only: set VITE_DEMO_MODE=true in your private .env to enable
# the login workspace picker and client-side demo role switching.
VITE_DEMO_MODE=false

# Optional: override API base for integration test scripts
# API_BASE=http://localhost:3000/api/v1

# Skylent AI (server-side only — never prefix with VITE_)
# When unset, the lesson assistant shows “Skylent AI isn’t available yet.”
# Learners never see these names. Do not put keys in frontend code.
# SKYLENT_AI_PROVIDER=openai-compatible
#   openai-compatible — call SKYLENT_AI_BASE_URL/chat/completions with SKYLENT_AI_API_KEY
#   lesson-grounded   — preview/tests only; answers from authored lesson text (not a production LLM)
#   off | none        — force unavailable
# SKYLENT_AI_API_KEY=
# SKYLENT_AI_BASE_URL=https://api.openai.com/v1
# SKYLENT_AI_MODEL=gpt-4o-mini
# SKYLENT_AI_TIMEOUT_MS=30000
# SKYLENT_AI_MAX_OUTPUT_TOKENS=800
# SKYLENT_AI_RATE_LIMIT_WINDOW_MS=900000
# SKYLENT_AI_RATE_LIMIT_MAX=40
#
# Keys are server-side only. Never use VITE_ for AI secrets.
# lesson-grounded is preview/testing (deterministic lesson text, not a vendor LLM).
# Production ignores lesson-grounded unless SKYLENT_AI_ALLOW_GROUNDED=1 (do not set that in production).
# openai-compatible requires SKYLENT_AI_API_KEY and calls SKYLENT_AI_BASE_URL/chat/completions.
# If no key is configured, Skylent AI stays unavailable and the rest of the app works.
# First deploy catalog load (Railway predeploy): SKYLENT_RUN_SEED=1
# Rebuilding catalog after it exists deletes learner progress: SKYLENT_ALLOW_DESTRUCTIVE_SEED=1
# Live vendor smoke (optional, never runs in CI by default):
#   SKYLENT_AI_LIVE_SMOKE=1 pnpm test:ai:live
# That script refuses to treat lesson-grounded as a live vendor success.
