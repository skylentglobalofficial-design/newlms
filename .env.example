# Database
DATABASE_URL=
DIRECT_URL=

# Session / cookies
SESSION_SECRET=
COOKIE_SECURE=false

# Frontend origin used for OAuth redirects (local: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Google OAuth (register redirect URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Frontend feature flags
VITE_DEMO_MODE=true

# Development demo users (created by npm run db:seed)
# Password: DemoSkylent2026! (override with DEMO_USER_PASSWORD)
# Demo users are skipped in production unless explicitly enabled:
# SEED_DEMO_USERS=true
#
# Accounts:
#   learner@demo.skylent.dev
#   mentor@demo.skylent.dev
#   institution@demo.skylent.dev
#   recruiter@demo.skylent.dev
#   admin@demo.skylent.dev
#
# See prisma/DEMO_ACCOUNTS.md for seeded data and role behavior.
# See docs/LMS_ENVIRONMENT.md for Mux/R2 configuration and honest degraded behaviour.
# See docs/CATALOG_DATA_SYNC.md for catalog ↔ LMS data alignment.

# Optional: override API base for integration test scripts
# API_BASE=http://localhost:3000/api/v1

# ---------------------------------------------------------------------------
# Mux demo video (one lesson vertical slice)
# ---------------------------------------------------------------------------
# Set to a REAL Mux playback ID for data-analytics/l1 ("What is Data Analytics?").
# Create an asset in the Mux dashboard, copy its playback ID, then run: npm run db:seed
# When unset, l1 keeps the honest "video unavailable" preview state.
#
# MUX_DEMO_PLAYBACK_ID=

# ---------------------------------------------------------------------------
# Cloudflare R2 object storage (lesson materials: PDF/PPT/PPTX)
# ---------------------------------------------------------------------------
# Required for faculty upload and learner presigned download. When unset, material
# upload endpoints return 503 and downloads are unavailable (honest degraded state).
#
# R2_ACCOUNT_ID=           # Cloudflare account ID
# R2_ACCESS_KEY_ID=        # R2 API token access key
# R2_SECRET_ACCESS_KEY=    # R2 API token secret
# R2_BUCKET_NAME=          # Private bucket name (do not make public)
# R2_ENDPOINT=             # Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#
# Bucket CORS (configure in Cloudflare R2 dashboard for browser PUT uploads):
#   Allowed origins: your app origins from FRONTEND_URL / deployment URLs
#     (e.g. http://localhost:5173, https://your-preview.example.com)
#   Allowed methods: PUT, HEAD, GET
#   Allowed headers: Content-Type, Content-Length, x-amz-*
#   Expose headers: ETag (optional)
#   Max age: 3600
#
# GET is required when the learner UI verifies downloads via fetch() before saving.
# Direct navigation to a presigned GET URL may work without app-origin CORS.
#
# MIME validation: the API validates declared MIME types only. Client-declared MIME
# is not equivalent to file-content inspection; do not treat this as malware scanning.
#
# Orphan objects: abandoned PENDING uploads may leave objects in R2 without a READY
# row. Future cleanup can use R2 lifecycle rules on lesson-materials/ prefix or a
# worker; abandoned drafts cannot be published without complete-upload verification.
