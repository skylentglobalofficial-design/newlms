# Database
DATABASE_URL=
DIRECT_URL=

# Session / cookies
SESSION_SECRET=
COOKIE_SECURE=false

# Frontend origin used for OAuth redirects (local: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Google OAuth (register redirect URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Frontend feature flags
VITE_DEMO_MODE=true

# Development demo users (created by npm run db:seed)
# Password: DemoSkylent2026! (override with DEMO_USER_PASSWORD)
# Demo users are skipped in production unless explicitly enabled:
# SEED_DEMO_USERS=true
#
# Accounts:
#   learner@demo.skylent.dev
#   mentor@demo.skylent.dev
#   institution@demo.skylent.dev
#   recruiter@demo.skylent.dev
#   admin@demo.skylent.dev
#
# See prisma/DEMO_ACCOUNTS.md for seeded data and role behavior.

# Optional: override API base for integration test scripts
# API_BASE=http://localhost:3000/api/v1

# Cloudflare R2 object storage (lesson materials: PDF/PPT/PPTX)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# Optional custom endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
