# Database (both are required for Prisma CLI, migrations, and production/CI)
# DATABASE_URL — pooled/runtime connection string used by the application.
# DIRECT_URL — direct/non-pooled connection string used by Prisma migrate and validate.
# In many hosted Postgres setups these are the same URL; in serverless/pooled setups
# DIRECT_URL must bypass the pooler (e.g. Supabase "direct" connection).
# Never commit real credentials.
DATABASE_URL=
DIRECT_URL=

# Session / cookies
SESSION_SECRET=
COOKIE_SECURE=false

# Frontend origin used for OAuth redirects (local: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins allowed for credentialed API requests.
# When unset, FRONTEND_URL is used. In development, common localhost ports are also allowed.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443

# Optional API hardening overrides
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# JSON_BODY_LIMIT=512kb

# Google OAuth (register redirect URI in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# First superadmin bootstrap (used by `npm run bootstrap:superadmin`).
# Never commit real values. SUPERADMIN_PASSWORD is only required when the
# account does not exist yet and must be at least 12 characters.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=

# Frontend feature flags
# Production / committed builds MUST use false (see .env.production).
# Local development only: set VITE_DEMO_MODE=true in your private .env to enable
# the login workspace picker and client-side demo role switching.
VITE_DEMO_MODE=false

# Artifact storage (LMS assignment uploads)
# local (default) writes opaque keys under ARTIFACT_STORAGE_ROOT.
# s3 requires ARTIFACT_S3_BUCKET plus AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# and optionally ARTIFACT_S3_ENDPOINT / ARTIFACT_S3_REGION / ARTIFACT_S3_PREFIX.
# ARTIFACT_STORAGE_PROVIDER=local
# ARTIFACT_STORAGE_ROOT=storage/lms-artifacts
# ARTIFACT_MAX_BYTES=25000000

# Certificate issuer name shown on issued completion records.
# This is a configured label, not an accreditation claim.
# CERTIFICATE_ISSUER=Skylent
