generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  ADMIN
  FACULTY
  STUDENT
  RECRUITER
  ORGANISATION_ADMIN
}

enum ProgramType {
  SCHOOLING
  UNDERGRADUATE
  POSTGRADUATE
  EXAM_PREP
  WEBINAR
  CERTIFICATE
  PROFESSIONAL
}

enum EnrollmentStatus {
  OPEN
  WAITLIST
  COMING_SOON
}

enum CurriculumNodeType {
  VIDEO
  NOTES
  QUIZ
  ASSIGNMENT
  TOPIC
}

model User {
  id             String                   @id @default(uuid()) @db.Uuid
  email          String                   @unique
  passwordHash   String?
  displayName    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  roles          UserRole[]
  sessions       Session[]
  memberships    OrganisationMembership[]
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      RoleName   @unique
  createdAt DateTime   @default(now())
  users     UserRole[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  secretHash       String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organisation {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  slug         String                   @unique
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  OrganisationMembership[]
}

model OrganisationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model Program {
  id               String             @id @default(uuid()) @db.Uuid
  slug             String             @unique
  name             String
  duration         String
  moduleCount      Int
  projectCount     Int
  format           String
  cert             String
  outcome          String
  desc             String
  upcomingBatch    String
  programType      ProgramType
  level            String
  whoIsItFor       String[]
  whatYouWillLearn String[]
  learningExperience String[]
  careerSupport    Boolean?
  enrollmentStatus EnrollmentStatus?
  examPattern      String?
  examSections     String[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  pricing          PricingTier[]
  curriculum      CurriculumModule[]

  @@index([programType])
  @@index([enrollmentStatus])
}

model PricingTier {
  id            String   @id @default(uuid()) @db.Uuid
  programId     String   @db.Uuid
  name          String
  price         Int
  originalPrice Int
  features      String[]
  highlight     Boolean  @default(false)
  program       Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, name])
}

model Course {
  id            String             @id @default(uuid()) @db.Uuid
  slug          String             @unique
  title         String
  category      String
  level         String
  duration      String
  mode          String
  lessonCount   Int
  projectCount  Int
  rating        Float
  reviews       Int
  price         Int
  originalPrice Int
  desc          String
  longDesc      String
  outcomes      String[]
  forWhom       String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  curriculum    CurriculumModule[]

  @@index([category])
  @@index([level])
}

model CurriculumModule {
  id          String             @id @default(uuid()) @db.Uuid
  sourceId    String?
  order       Int
  number      String?
  title       String
  description String?
  duration    String?
  topics      String[]
  programId   String?            @db.Uuid
  courseId    String?            @db.Uuid
  program     Program?           @relation(fields: [programId], references: [id], onDelete: Cascade)
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nodes       CurriculumNode[]

  @@unique([courseId, sourceId])
  @@unique([programId, number])
  @@index([courseId, order])
  @@index([programId, order])
}

model CurriculumNode {
  id          String              @id @default(uuid()) @db.Uuid
  sourceId    String?
  order       Int
  title       String
  nodeType    CurriculumNodeType
  duration    String?
  completed   Boolean             @default(false)
  moduleId    String              @db.Uuid
  module      CurriculumModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sourceId])
  @@index([moduleId, order])
}