generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  ADMIN
  FACULTY
  STUDENT
  RECRUITER
  ORGANISATION_ADMIN
}

enum ProgramType {
  SCHOOLING
  UNDERGRADUATE
  POSTGRADUATE
  EXAM_PREP
  WEBINAR
  CERTIFICATE
  PROFESSIONAL
}

enum EnrollmentStatus {
  OPEN
  WAITLIST
  COMING_SOON
}

enum CurriculumNodeType {
  VIDEO
  NOTES
  QUIZ
  ASSIGNMENT
  TOPIC
}

enum PracticeInteractionType {
  choose
}

enum UserEnrollmentStatus {
  active
  completed
  withdrawn
}

enum AssignmentStatus {
  not_started
  in_progress
  submitted
}

enum CertificateStatus {
  locked
  eligible
  issued
}

enum CareerWorkMode {
  REMOTE
  HYBRID
  ONSITE
  FLEXIBLE
}

enum CareerProfileVisibility {
  PRIVATE
  NETWORK
  PUBLIC
}

enum CareerEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  OTHER
}

enum CareerLinkType {
  LINKEDIN
  GITHUB
  PORTFOLIO
  OTHER
}

enum CareerSkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ResumeVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EmployerVerificationStatus {
  PENDING
  VERIFIED
  UNVERIFIED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  EXPIRED
}

enum JobApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum InterviewRoundType {
  TECHNICAL
  HR
  MANAGERIAL
  OTHER
}

enum InterviewRoundStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  PENDING
}

enum InterviewQuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum CareerSupportRequestType {
  RESUME_REVIEW
  INTERVIEW_PREP
  JOB_SEARCH
  GENERAL
}

enum CareerSupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CareerSupportPriority {
  LOW
  MEDIUM
  HIGH
}

enum CareerSupportTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  email              String                   @unique
  passwordHash       String?
  displayName        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  roles              UserRole[]
  sessions           Session[]
  identities         UserIdentity[]
  memberships        OrganisationMembership[]
  enrollments        UserEnrollment[]
  quizAttempts       QuizAttempt[]
  assignmentProgress AssignmentProgress[]
  careerProfile      CareerProfile?
  savedJobs          SavedJob[]
  jobApplications    JobApplication[]
  interviewRounds    InterviewRound[]
  interviewPractice  InterviewPractice[]
  supportRequests    CareerSupportRequest[]
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      RoleName   @unique
  createdAt DateTime   @default(now())
  users     UserRole[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  secretHash String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Organisation {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String
  slug        String                   @unique
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganisationMembership[]
}

model OrganisationMembership {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model Program {
  id                 String             @id @default(uuid()) @db.Uuid
  slug               String             @unique
  name               String
  duration           String
  moduleCount        Int
  projectCount       Int
  format             String
  cert               String
  outcome            String
  desc               String
  upcomingBatch      String
  programType        ProgramType
  level              String
  whoIsItFor         String[]
  whatYouWillLearn   String[]
  learningExperience String[]
  careerSupport      Boolean?
  enrollmentStatus   EnrollmentStatus?
  examPattern        String?
  examSections       String[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  pricing            PricingTier[]
  curriculum         CurriculumModule[]
  enrollments        UserEnrollment[]
  programCourses     ProgramCourse[]

  @@index([programType])
  @@index([enrollmentStatus])
}

model PricingTier {
  id            String  @id @default(uuid()) @db.Uuid
  programId     String  @db.Uuid
  name          String
  price         Int
  originalPrice Int
  features      String[]
  highlight     Boolean @default(false)
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, name])
}

model Course {
  id            String             @id @default(uuid()) @db.Uuid
  slug          String             @unique
  title         String
  category      String
  level         String
  duration      String
  mode          String
  lessonCount   Int
  projectCount  Int
  rating        Float
  reviews       Int
  price         Int
  originalPrice Int
  desc          String
  longDesc      String
  outcomes      String[]
  forWhom       String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  curriculum    CurriculumModule[]
  enrollments   UserEnrollment[]
  programCourses ProgramCourse[]

  @@index([category])
  @@index([level])
}

model CurriculumModule {
  id          String             @id @default(uuid()) @db.Uuid
  sourceId    String?
  order       Int
  number      String?
  title       String
  description String?
  duration    String?
  topics      String[]
  programId   String?            @db.Uuid
  courseId    String?            @db.Uuid
  program     Program?           @relation(fields: [programId], references: [id], onDelete: Cascade)
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nodes       CurriculumNode[]

  @@unique([courseId, sourceId])
  @@unique([programId, number])
  @@index([courseId, order])
  @@index([programId, order])
}

model CurriculumNode {
  id                    String               @id @default(uuid()) @db.Uuid
  sourceId              String?
  order                 Int
  title                 String
  nodeType              CurriculumNodeType
  duration              String?
  completed             Boolean              @default(false)
  muxPlaybackId         String?
  moduleId              String               @db.Uuid
  module                CurriculumModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgress        LessonProgress[]
  quizQuestions         QuizQuestion[]
  quizAttempts          QuizAttempt[]
  assignmentProgress    AssignmentProgress[]
  lessonPractice        LessonPractice?
  lastAccessedEnrollments UserEnrollment[]   @relation("LastAccessedNode")

  @@unique([moduleId, sourceId])
  @@index([moduleId, order])
}

/// Lesson-scoped Practice content for LMS Phase 3 (content foundation).
/// One optional Practice object per curriculum node. Not a quiz engine.
model LessonPractice {
  id                 String                  @id @default(uuid()) @db.Uuid
  nodeId             String                  @unique @db.Uuid
  interactionType    PracticeInteractionType @default(choose)
  context            String                  @db.Text
  task               String                  @db.Text
  preferredOptionKey String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  node    CurriculumNode          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  options LessonPracticeOption[]
}

model LessonPracticeOption {
  id               String @id @default(uuid()) @db.Uuid
  practiceId       String @db.Uuid
  optionKey        String
  sortOrder        Int
  label            String
  teachingFeedback String @db.Text

  practice LessonPractice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@unique([practiceId, optionKey])
  @@index([practiceId, sortOrder])
}

model UserEnrollment {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  courseId            String?              @db.Uuid
  programId           String?              @db.Uuid
  status              UserEnrollmentStatus @default(active)
  lastAccessedNodeId  String?              @db.Uuid
  certificateStatus   CertificateStatus    @default(locked)
  certificateEligible Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  program            Program?             @relation(fields: [programId], references: [id], onDelete: Cascade)
  lastAccessedNode   CurriculumNode?      @relation("LastAccessedNode", fields: [lastAccessedNodeId], references: [id], onDelete: SetNull)
  lessonProgress     LessonProgress[]
  quizAttempts       QuizAttempt[]
  assignmentProgress AssignmentProgress[]

  @@unique([userId, courseId])
  @@unique([userId, programId])
  @@index([userId])
  @@index([courseId])
  @@index([programId])
}

model LessonProgress {
  id             String    @id @default(uuid()) @db.Uuid
  enrollmentId   String    @db.Uuid
  nodeId         String    @db.Uuid
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  enrollment UserEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  node       CurriculumNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, nodeId])
  @@index([enrollmentId])
  @@index([nodeId])
}

model QuizQuestion {
  id           String @id @default(uuid()) @db.Uuid
  nodeId       String @db.Uuid
  sortOrder    Int
  question     String @db.Text
  options      Json
  correctIndex Int

  node CurriculumNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, sortOrder])
}

model QuizAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  enrollmentId   String   @db.Uuid
  nodeId         String   @db.Uuid
  attemptNumber  Int
  score          Int?
  totalQuestions Int?
  passed         Boolean  @default(false)
  answers        Json?
  submittedAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment UserEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  node       CurriculumNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([userId, nodeId])
  @@index([enrollmentId])
}

model AssignmentProgress {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  enrollmentId String           @db.Uuid
  nodeId       String           @db.Uuid
  status       AssignmentStatus @default(not_started)
  responseText String?          @db.Text
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment  UserEnrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  node        CurriculumNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  attachments AssignmentAttachment[]

  @@unique([enrollmentId, nodeId])
  @@index([userId])
}

model ProgramCourse {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @db.Uuid
  courseId  String   @db.Uuid
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
  @@index([programId, sortOrder])
  @@index([courseId])
}

model AssignmentAttachment {
  id                   String   @id @default(uuid()) @db.Uuid
  assignmentProgressId String   @db.Uuid
  fileName             String
  mimeType             String
  byteSize             Int
  storageProvider      String
  storageKey           String
  createdAt            DateTime @default(now())

  assignmentProgress AssignmentProgress @relation(fields: [assignmentProgressId], references: [id], onDelete: Cascade)

  @@index([assignmentProgressId])
}

model CareerProfile {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @unique @db.Uuid
  headline          String?
  summary           String?                 @db.Text
  location          String?
  phone             String?
  preferredRole     String?
  preferredWorkMode CareerWorkMode?
  profileVisibility CareerProfileVisibility @default(PRIVATE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  education      CareerEducation[]
  experience     CareerExperience[]
  skills         CareerSkill[]
  projects       CareerProject[]
  links          CareerLink[]
  resumeVersions CareerResumeVersion[]

  @@index([userId])
}

model CareerEducation {
  id               String    @id @default(uuid()) @db.Uuid
  profileId        String    @db.Uuid
  institution      String
  degree           String
  fieldOfStudy     String?
  startDate        DateTime?
  endDate          DateTime?
  currentlyStudying Boolean  @default(false)
  grade            String?
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model CareerExperience {
  id               String                @id @default(uuid()) @db.Uuid
  profileId        String                @db.Uuid
  company          String
  role             String
  employmentType   CareerEmploymentType?
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  currentlyWorking Boolean               @default(false)
  description      String?               @db.Text
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model CareerSkill {
  id          String                 @id @default(uuid()) @db.Uuid
  profileId   String                 @db.Uuid
  name        String
  category    String?
  proficiency CareerSkillProficiency?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId, sortOrder])
}

model CareerProject {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @db.Uuid
  title         String
  description   String?  @db.Text
  technologies  String[]
  projectUrl    String?
  repositoryUrl String?
  outcome       String?  @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model CareerLink {
  id        String         @id @default(uuid()) @db.Uuid
  profileId String         @db.Uuid
  type      CareerLinkType
  label     String?
  url       String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, sortOrder])
}

model CareerResumeVersion {
  id              String              @id @default(uuid()) @db.Uuid
  profileId       String              @db.Uuid
  label           String
  version         Int                 @default(1)
  fileName        String?
  mimeType        String?
  byteSize        Int?
  storageProvider String?
  storageKey      String?
  notes           String?             @db.Text
  status          ResumeVersionStatus @default(DRAFT)
  isPrimary       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  profile CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isPrimary])
  @@index([profileId, status])
}

model Employer {
  id                 String                     @id @default(uuid()) @db.Uuid
  name               String
  slug               String                     @unique
  description        String?                    @db.Text
  website            String?
  logoRef            String?
  location           String?
  verificationStatus EmployerVerificationStatus @default(PENDING)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  jobs         Job[]
  applications JobApplication[]

  @@index([verificationStatus])
  @@index([location])
}

model Job {
  id              String               @id @default(uuid()) @db.Uuid
  employerId      String               @db.Uuid
  title           String
  slug            String               @unique
  description     String               @db.Text
  employmentType  CareerEmploymentType?
  workMode        CareerWorkMode?
  location        String?
  experienceMin   Int?
  experienceMax   Int?
  salaryMin       Int?
  salaryMax       Int?
  skills          String[]
  category        String?
  status          JobStatus            @default(DRAFT)
  applicationUrl  String?
  postedAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  employer     Employer         @relation(fields: [employerId], references: [id], onDelete: Cascade)
  savedBy      SavedJob[]
  applications JobApplication[]

  @@index([employerId])
  @@index([status])
  @@index([category])
  @@index([workMode])
  @@index([location])
  @@index([postedAt])
}

model SavedJob {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  jobId     String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model JobApplication {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  jobId        String?              @db.Uuid
  employerId   String?              @db.Uuid
  roleTitle    String?
  status       JobApplicationStatus @default(APPLIED)
  appliedAt    DateTime?
  nextActionAt DateTime?
  notes        String?              @db.Text
  source       String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  employer        Employer?          @relation(fields: [employerId], references: [id], onDelete: SetNull)
  events          ApplicationEvent[]
  interviewRounds InterviewRound[]

  @@index([userId, status])
  @@index([jobId])
  @@index([employerId])
}

model ApplicationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid
  type          String
  title         String
  description   String?  @db.Text
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
}

model InterviewRound {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  applicationId String?              @db.Uuid
  type          InterviewRoundType
  title         String
  scheduledAt   DateTime?
  status        InterviewRoundStatus @default(PENDING)
  notes         String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application JobApplication?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  practice    InterviewPractice[]

  @@index([userId, status])
  @@index([applicationId])
}

model InterviewQuestion {
  id         String                      @id @default(uuid()) @db.Uuid
  category   String
  question   String                      @db.Text
  difficulty InterviewQuestionDifficulty @default(MEDIUM)
  roleTag    String?
  active     Boolean                     @default(true)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  practice InterviewPractice[]

  @@index([category, active])
  @@index([difficulty])
  @@index([roleTag])
}

model InterviewPractice {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  questionId       String?  @db.Uuid
  interviewRoundId String?  @db.Uuid
  answer           String?  @db.Text
  score            Int?
  practicedAt      DateTime @default(now())
  feedback         String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  interviewRound InterviewRound?  @relation(fields: [interviewRoundId], references: [id], onDelete: SetNull)

  @@index([userId, practicedAt])
  @@index([questionId])
  @@index([interviewRoundId])
}

model CareerSupportRequest {
  id          String                     @id @default(uuid()) @db.Uuid
  userId      String                     @db.Uuid
  type        CareerSupportRequestType
  subject     String
  description String                     @db.Text
  status      CareerSupportRequestStatus @default(OPEN)
  priority    CareerSupportPriority      @default(MEDIUM)
  assignedTo  String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  user  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks CareerSupportTask[]

  @@index([userId, status])
  @@index([priority])
}

model CareerSupportTask {
  id          String                  @id @default(uuid()) @db.Uuid
  requestId   String                  @db.Uuid
  title       String
  description String?                 @db.Text
  status      CareerSupportTaskStatus @default(PENDING)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  request CareerSupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
}
